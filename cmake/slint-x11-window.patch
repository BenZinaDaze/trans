+    /// Trans C++ adapter: return the actual native X11 window, never a scanned window.
+    #[unsafe(no_mangle)]
+    pub unsafe extern "C" fn slint_windowrc_xid_x11(
+        handle: *const WindowAdapterRcOpaque,
+    ) -> u64 {
+        use raw_window_handle_06::HasWindowHandle;
+        if let Some(adapter) = has_window_handle(handle)
+            && let Ok(window) = adapter.window_handle()
+        {
+            match window.as_raw() {
+                raw_window_handle_06::RawWindowHandle::Xlib(x) => x.window as u64,
+                raw_window_handle_06::RawWindowHandle::Xcb(x) => x.window.get() as u64,
+                _ => 0,
+            }
+        } else {
+            0
+        }
+    }
+
